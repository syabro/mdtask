---
import '../styles/global.css'
---

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>mdtask — Tasks and spec in one file</title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Shantell+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
</head>

<body class="font-sans">

<!-- ============ TOP BAR ============ -->
<header class="sticky top-0 z-50 bg-topbar border-b border-line-soft backdrop-blur-md backdrop-saturate-150">
  <div class="mx-auto max-w-page px-5 sm:px-8 lg:px-14 py-3.5 flex items-center justify-between">
    <div class="flex items-baseline gap-2 text-body font-medium">
      <span class="font-mono font-semibold text-acc">[x]</span><span class="font-mono font-semibold text-ink">mdtask</span>
    </div>
    <nav class="flex items-center gap-6 text-ui font-medium text-ink-soft">
      <a href="#format" class="hidden sm:inline hover:text-ink transition-colors">Format</a>
      <a href="#diff" class="hidden sm:inline hover:text-ink transition-colors">How it works</a>
      <a href="#faq" class="hidden sm:inline hover:text-ink transition-colors">FAQ</a>
      <a href="#setup" class="btn sm">Get started</a>
      <a href="https://github.com" target="_blank" rel="noopener" aria-label="Star on GitHub" class="inline-flex items-center justify-center p-2 -mx-1 rounded-lg text-ink-soft hover:text-ink hover:bg-bg-alt transition-colors">
        <svg width="19" height="19" viewBox="0 0 16 16" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>
      </a>
    </nav>
  </div>
</header>

<!-- ============ HERO ============ -->
<section class="pt-16 pb-24">
  <div class="mx-auto max-w-page px-5 sm:px-8 lg:px-14 flex flex-col lg:flex-row gap-11 lg:gap-14 items-center">
    <div class="lg:flex-[0_0_500px] lg:max-w-[500px] min-w-0">
      <div class="inline-flex items-center gap-2 whitespace-nowrap text-eyebrow uppercase text-muted">
        <span class="size-1.5 rounded-full bg-acc block"></span>Open-source CLI
      </div>
      <h1 class="mt-4 text-h1 text-ink">Tasks and spec<br />in one file.</h1>
      <p class="mt-4 text-lead text-ink-soft">mdtask keeps your tasks as Markdown checkboxes inside the same
        <code>.md</code> files as the spec itself. Close a task and update the spec in one
        git commit. Your coding agent reads and edits the file directly — like code, not a
        separate tool.</p>
      <div class="actions flex flex-wrap gap-3 mt-7 items-center">
        <copy-field command="npm install -g mdtask"></copy-field>
        <a class="btn" href="https://github.com" target="_blank" rel="noopener">
          <svg width="17" height="17" viewBox="0 0 16 16" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>
          Star on GitHub
        </a>
      </div>
    </div>

    <!-- file card -->
    <div class="flex-1 min-w-0 flex justify-start">
      <div class="card hero-file" style="max-width:512px;">
        <div class="card-head"><span class="tl"><i></i><i></i><i></i></span><span class="fname">docs/prd/auth.md</span></div>
        <div class="code hero-code">
          <div class="brace-block">
            <div class="ln"><span class="h"># Authentication</span></div>
            <div class="sp"></div>
            <div class="ln"><span class="h">## Login</span></div>
            <div class="ln"><span class="dim">Users sign in with email and password.</span></div>
            <div class="ln"><span class="dim">Sessions last 30 days; refresh tokens rotate on every use.</span></div>
            <div class="ln"><span class="dim">Repeated failures are throttled per IP and per account.</span></div>
            <div class="gbrace">
              <svg viewBox="0 0 24 100" preserveAspectRatio="none" width="16" fill="none" stroke="currentColor" stroke-width="1.15" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 2 C17 2 17 18 17 34 C17 43 20 48 23 50 C20 52 17 57 17 66 C17 82 17 98 5 98" /></svg>
              <span class="lbl">spec</span>
            </div>
          </div>

          <div class="ln dots3" style="padding-top:6px;">· · ·</div>
          <div class="sp"></div>

          <div class="brace-block">
            <div class="ln"><span class="h"># Tasks</span></div>
            <div class="ln done"><span class="box">- [</span><span class="ck">x</span><span class="box">] </span><span class="id">AUTH-001</span><span class="txt">  Add email and password login</span></div>
            <div class="ln"><span class="note">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<span class="imp">**Implemented:**</span></span></div>
            <div class="ln"><span class="note">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;POST /auth/login verifies the password hash</span></div>
            <div class="ln"><span class="note">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;and issues a 30-day session cookie.</span></div>
            <div class="sp"></div>
            <div class="ln done"><span class="box">- [</span><span class="ck">x</span><span class="box">] </span><span class="id">AUTH-003</span><span class="txt">  Rotate refresh tokens on every use</span></div>
            <div class="ln"><span class="note">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<span class="imp">**Implemented:**</span></span></div>
            <div class="ln"><span class="note">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Each refresh swaps the token, revokes the old one.</span></div>
            <div class="sp"></div>
            <div class="ln"><span class="box">- [ ] </span><span class="id">AUTH-004</span><span class="txt">  Add passwordless magic-link login          !high</span></div>
            <div class="ln"><span class="note">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Email a one-time link that signs the user in.</span></div>
            <div class="sp"></div>
            <div class="ln"><span class="box">- [ ] </span><span class="id">AUTH-005</span><span class="txt">  Rate-limit the magic-link    </span><span class="blk">@blocked_by:</span><span class="id">AUTH-004</span></div>
            <div class="ln"><span class="note">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Cap requests per email and per IP once the endpoint exists.</span></div>
            <div class="gbrace">
              <svg viewBox="0 0 24 100" preserveAspectRatio="none" width="16" fill="none" stroke="currentColor" stroke-width="1.15" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 2 C17 2 17 18 17 34 C17 43 20 48 23 50 C20 52 17 57 17 66 C17 82 17 98 5 98" /></svg>
              <span class="lbl">tasks</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ============ 01 — FORMAT ============ -->
<section id="format" class="bg-bg-alt py-20 lg:py-26">
  <div class="mx-auto max-w-prose px-5 sm:px-8 lg:px-14">
    <h2 class="text-h2 text-ink">It's just Markdown.</h2>
    <p class="mt-4 text-body text-ink-soft">Two zones in one file. The prose on top describes what the product does
      today. The checkboxes under <code>## Tasks</code> are the work that implements it.</p>

    <div class="card mt-10">
      <div class="card-head"><span class="tl"><i></i><i></i><i></i></span><span class="fname">docs/prd/auth.md</span></div>
      <div class="code">
        <div class="ln"><span class="h"># Authentication</span></div>
        <div class="sp"></div>
        <div class="ln"><span class="h">## Login</span></div>
        <div class="ln"><span class="dim">Email and password.</span></div>
        <div class="sp"></div>
        <div class="ln"><span class="h">## Tasks</span></div>
        <div class="ln done"><span class="box">- [</span><span class="ck">x</span><span class="box">] </span><span class="id">AUTH-001</span><span class="txt">  Email + password login</span></div>
        <div class="sp"></div>
        <div class="ln done"><span class="box">- [</span><span class="ck">x</span><span class="box">] </span><span class="id">AUTH-002</span><span class="txt">  Password reset over email</span></div>
        <div class="sp"></div>
        <div class="ln"><span class="box">- [ ] </span><span class="id">AUTH-004</span><span class="txt">  Magic-link login                    !high</span></div>
        <div class="ln"><span class="note">      Send a one-time link to the user's email.</span></div>
        <div class="ln"><span class="note">      Signs them in, no password needed.</span></div>
        <div class="sp"></div>
        <div class="ln"><span class="box">- [ ] </span><span class="id">AUTH-005</span><span class="txt">  Rate-limit login attempts</span><span class="blk">           @blocked_by:</span><span class="id">AUTH-004</span></div>
      </div>
    </div>
    <p class="mt-6 text-body text-ink-soft">Renders on GitHub. Opens in any editor or Obsidian. Diffs like any text file.
      No lock-in — the annotations are readable and editable by hand.</p>
  </div>
</section>

<!-- ============ 02 — AGENT FINDS A TASK ============ -->
<section id="agent" class="py-20 lg:py-26">
  <div class="mx-auto max-w-prose px-5 sm:px-8 lg:px-14">
    <h2 class="text-h2 text-ink">The agent picks the next task itself.</h2>

    <div class="term mt-9">
      <div class="card-head"><span class="tl"><i></i><i></i><i></i></span><span class="fname">terminal</span></div>
      <div class="code">
        <div class="ln"><span class="prompt">$</span> mdtask list</div>
        <div class="ln">  <span class="tbox">[ ]</span> <span class="tid">AUTH-004</span>  Magic-link login        <span class="tflag">!high</span></div>
        <div class="ln tblocked">  [ ] AUTH-005  Rate-limit login        ⊘ blocked by AUTH-004</div>
      </div>
    </div>

    <p class="mt-7 text-body text-ink-soft"><code>mdtask list</code> queries your files and shows what's ready to
      work on. <b class="whitespace-nowrap text-ink font-semibold">AUTH-005</b> is blocked by <b class="whitespace-nowrap text-ink font-semibold">AUTH-004</b>, so the agent
      skips it and takes <b class="whitespace-nowrap text-ink font-semibold">AUTH-004</b>. Filter by tag and priority; dependencies come from
      <code>@blocked_by</code>. The agent reads the files directly to decide what to do — no API,
      no separate board.</p>
  </div>
</section>

<!-- ============ 03 — COMMIT ============ -->
<section id="commit" class="bg-bg-alt py-20 lg:py-26">
  <div class="mx-auto max-w-prose px-5 sm:px-8 lg:px-14">
    <h2 class="text-h2 text-ink">Closing a task documents it.</h2>
    <p class="mt-4 text-body text-ink-soft">Before committing, the agent does it in one move: update the prose spec on
      top, write an <code>Implemented:</code> note in the task body, check the box. Then commit.</p>

    <div class="card mt-9">
      <div class="card-head"><span class="tl"><i></i><i></i><i></i></span><span class="fname">docs/prd/auth.md</span></div>
      <div class="code">
        <div class="ln done"><span class="box">- [</span><span class="ck">x</span><span class="box">] </span><span class="id">AUTH-004</span><span class="txt">  Magic-link login   !high</span></div>
        <div class="ln"><span class="note">      Send a one-time link to the user's email.</span></div>
        <div class="ln"><span class="note">      **Implemented:** POST /auth/magic-link issues a signed token (15-min TTL);</span></div>
        <div class="ln"><span class="note">      /auth/magic-link/verify signs the user in.</span></div>
      </div>
    </div>
    <p class="mt-6 text-body text-ink-soft">This is a step the agent follows (via the <code>/mdtask-next</code> skill), not a gate
      mdtask enforces. mdtask won't block a commit that skips the spec.</p>
  </div>
</section>

<!-- ============ 04 — DIFF ============ -->
<section id="diff" class="py-20 lg:py-26">
  <div class="mx-auto max-w-prose px-5 sm:px-8 lg:px-14">
    <h2 class="text-h2 text-ink">One commit. One file.<br />Spec and code move together.</h2>
  </div>
  <div class="mx-auto max-w-prose px-5 sm:px-8 lg:px-14 mt-11">
    <div class="diff">
      <div class="dhead">docs/prd/auth.md</div>
      <div class="body">
        <div class="drow ctx"><span class="g"> </span><span class="h">## Login</span></div>
        <div class="drow ctx"><span class="g"> </span>Email and password.</div>
        <div class="drow add"><span class="g">+</span>Passwordless magic-link: a one-time link signs the user in.</div>
        <div class="drow ctx"><span class="g"> </span> </div>
        <div class="drow ctx"><span class="g"> </span><span class="h">## Tasks</span></div>
        <div class="drow del"><span class="g">-</span>- [ ] AUTH-004  Magic-link login   !high</div>
        <div class="drow add"><span class="g">+</span>- [x] AUTH-004  Magic-link login   !high</div>
        <div class="drow add"><span class="g">+</span>      **Implemented:** POST /auth/magic-link issues a signed token (15-min TTL).</div>
      </div>
    </div>
    <p class="mt-6 text-body text-ink-soft">The spec line at the top and the checkbox at the bottom
      changed in the <b class="text-ink font-semibold">same commit</b> — because there's no gap between
      them. It's just a file in git: the agent edited text, and you review a normal diff and merge it like any code.</p>
  </div>
</section>

<!-- ============ COMPARISON ============ -->
<section id="compare" class="bg-bg-alt py-20 lg:py-26">
  <div class="mx-auto max-w-prose px-5 sm:px-8 lg:px-14">
    <h2 class="text-h2 text-ink">How it's different.</h2>
    <p class="mt-4 text-body text-ink-soft">Same payoff against the whole class: your spec and tasks are one git artifact —
      there's no second system to keep in sync.</p>

    <div class="mt-10 border-t border-line">
      <div class="grid grid-cols-1 lg:grid-cols-[minmax(170px,210px)_1fr] gap-2.5 lg:gap-9 py-6 px-1 border-b border-line items-start">
        <div class="text-h4 text-ink">SDD frameworks<span class="block font-mono text-ui font-medium text-muted mt-1.5">Spec Kit<br />OpenSpec</span></div>
        <div class="text-body text-ink-soft">Keep spec, plan, and tasks as separate artifacts. There's a gap between them
          where they drift. <b class="text-ink font-semibold">mdtask keeps tasks inside the spec file</b> — nothing to sync.</div>
      </div>
      <div class="grid grid-cols-1 lg:grid-cols-[minmax(170px,210px)_1fr] gap-2.5 lg:gap-9 py-6 px-1 border-b border-line items-start">
        <div class="text-h4 text-ink">Trackers<span class="block font-mono text-ui font-medium text-muted mt-1.5">GitHub Issues<br />Jira<br />Linear</span></div>
        <div class="text-body text-ink-soft">A task is a separate object tied to the repo — the issue lives in the tracker's
          database, never in your files or your diff. <b class="text-ink font-semibold">mdtask keeps the task in the same file as the
          spec</b>, under one git history.</div>
      </div>
      <div class="grid grid-cols-1 lg:grid-cols-[minmax(170px,210px)_1fr] gap-2.5 lg:gap-9 py-6 px-1 border-b border-line items-start">
        <div class="text-h4 text-ink">Flat TODO.md<span class="block font-mono text-ui font-medium text-muted mt-1.5">plain checklist</span></div>
        <div class="text-body text-ink-soft">Same instinct, no structure. <b class="text-ink font-semibold">mdtask adds stable IDs, file queries, and a
          dependency graph</b> — still plain Markdown.</div>
      </div>
      <div class="grid grid-cols-1 lg:grid-cols-[minmax(170px,210px)_1fr] gap-2.5 lg:gap-9 py-6 px-1 border-b border-line items-start">
        <div class="text-h4 text-ink">Markdown note apps<span class="block font-mono text-ui font-medium text-muted mt-1.5">Obsidian<br />etc.</span></div>
        <div class="text-body text-ink-soft">Not a competitor — same files. <b class="text-ink font-semibold">mdtask adds a CLI on top.</b></div>
      </div>
    </div>
  </div>
</section>

<!-- ============ FAQ ============ -->
<section id="faq" class="py-20 lg:py-26">
  <div class="mx-auto max-w-prose px-5 sm:px-8 lg:px-14">
    <h2 class="text-h2 text-ink">Questions.</h2>
    <div class="mt-9 grid gap-0.5">
      <div class="border-t border-line py-6">
        <div class="text-h4 text-ink">Isn't this just a TODO file?</div>
        <div class="mt-2.5 text-body text-ink-soft">No. Tasks live in the same file as the spec, with stable IDs, an
          <code>@blocked_by</code> dependency graph, and queries. A plain TODO does none of that. Still Markdown.</div>
      </div>
      <div class="border-t border-line py-6">
        <div class="text-h4 text-ink">What about git merge conflicts?</div>
        <div class="mt-2.5 text-body text-ink-soft">Normal text conflicts in a <code>.md</code> file, resolved like any lines in git.
          Small, focused commits keep them rare. No magic auto-merge.</div>
      </div>
      <div class="border-t border-line py-6">
        <div class="text-h4 text-ink">Does my agent need setup?</div>
        <div class="mt-2.5 text-body text-ink-soft">Your agent installs the skill itself from one instruction, once. You don't set
          paths or install anything by hand.</div>
      </div>
      <div class="border-t border-b border-line py-6">
        <div class="text-h4 text-ink">What if I outgrow it?</div>
        <div class="mt-2.5 text-body text-ink-soft">It's Markdown in your repo. Annotations are readable and editable by hand with
          normal text tools. No lock-in — the files are already yours.</div>
      </div>
    </div>
  </div>
</section>

<!-- ============ SETUP ============ -->
<section id="setup" class="bg-bg-alt py-20 lg:py-26">
  <div class="mx-auto max-w-prose px-5 sm:px-8 lg:px-14">
    <h2 class="text-h2 text-ink">Get started in a minute.</h2>
    <p class="mt-3.5 text-body text-ink-soft">Your agent does this from one instruction — not you by hand.</p>

    <div class="mt-10 grid gap-5">
      <div class="grid grid-cols-[auto_1fr] gap-3 items-start">
        <div class="font-mono text-ui font-semibold text-muted leading-none pt-1.5">1</div>
        <div>
          <div class="text-body font-semibold text-ink">Install the CLI</div>
          <div class="mt-3"><copy-field command="npm install -g mdtask"></copy-field></div>
        </div>
      </div>
      <div class="grid grid-cols-[auto_1fr] gap-3 items-start">
        <div class="font-mono text-ui font-semibold text-muted leading-none pt-1.5">2</div>
        <div>
          <div class="text-body font-semibold text-ink">Paste this to your agent</div>
          <div class="mt-3"><copy-field block prompt="false" command="Install the mdtask skill, then pick the next unblocked task in docs/prd, implement it, update the spec in the same file, and close it."></copy-field></div>
        </div>
      </div>
      <div class="grid grid-cols-[auto_1fr] gap-3 items-start">
        <div class="font-mono text-ui font-semibold text-muted leading-none pt-1.5">3</div>
        <div>
          <div class="text-body font-semibold text-ink">Existing repo? <span class="font-medium text-faint text-ui">— optional</span></div>
          <div class="mt-3"><copy-field command="mdtask ids --path docs/prd/auth.md"></copy-field></div>
          <p class="mt-2.5 text-body text-ink-soft">Assigns IDs to checkboxes you already have. Nothing to rewrite by hand or
            migrate — <code>ids</code> edits the file, and it shows up as a normal git diff.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ============ CTA ============ -->
<section class="text-center py-30">
  <div class="mx-auto max-w-prose px-5 sm:px-8 lg:px-14">
    <h2 class="text-cta text-ink">A spec that ships with the code.</h2>
    <div class="block font-hand text-subline text-muted mt-7 -rotate-1">Because it's one file.</div>
    <div class="actions flex flex-wrap gap-3 justify-center items-center mt-9">
      <copy-field command="npm install -g mdtask"></copy-field>
      <a class="btn" href="https://github.com" target="_blank" rel="noopener">
        <svg width="17" height="17" viewBox="0 0 16 16" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>
        Star on GitHub
      </a>
    </div>
    <a class="inline-block mt-5 text-ui text-muted no-underline border-b border-line pb-0.5 hover:text-ink transition-colors" href="https://github.com" target="_blank" rel="noopener">Full command reference in the README →</a>
  </div>
</section>

<footer class="border-t border-line py-8">
