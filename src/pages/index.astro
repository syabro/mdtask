<script>
  // <copy-field command="..." [block] [prompt="false"]> — reusable copy field.
  // The field itself is plain text; only the small button copies.
  const CF_ICON_COPY = '<svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="5.5" y="5.5" width="9" height="9" rx="1.6"></rect><path d="M3.4 10.5H2.6A1.6 1.6 0 0 1 1 8.9V2.6A1.6 1.6 0 0 1 2.6 1H8.9A1.6 1.6 0 0 1 10.5 2.6v.8"></path></svg>';
  const CF_ICON_CHECK = '<svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8.5l3.3 3.3L13 4.6"></path></svg>';
  class CopyField extends HTMLElement {
    connectedCallback() {
      if (this._init) return; this._init = true;
      const cmd = this.getAttribute('command') || '';
      const showPrompt = this.getAttribute('prompt') !== 'false';
      this.classList.add('copyfield');
      if (this.hasAttribute('block')) this.classList.add('block');
      const cmdSpan = document.createElement('span');
      cmdSpan.className = 'cf-cmd';
      if (showPrompt) {
        const d = document.createElement('span');
        d.className = 'cf-dollar'; d.textContent = '$';
        cmdSpan.appendChild(d);
      }
      const t = document.createElement('span');
      t.className = 'cf-text'; t.textContent = cmd;
      cmdSpan.appendChild(t);
      const btn = document.createElement('button');
      btn.type = 'button'; btn.className = 'cf-btn';
      btn.setAttribute('aria-label', 'Copy'); btn.innerHTML = CF_ICON_COPY;
      btn.addEventListener('click', () => {
        if (navigator.clipboard) navigator.clipboard.writeText(cmd).catch(() => {});
        btn.classList.add('copied'); btn.innerHTML = CF_ICON_CHECK;
        clearTimeout(btn._t);
        btn._t = setTimeout(() => { btn.classList.remove('copied'); btn.innerHTML = CF_ICON_COPY; }, 1500);
      });
      this.appendChild(cmdSpan);
      this.appendChild(btn);
    }
  }
  customElements.define('copy-field', CopyField);
</script>
