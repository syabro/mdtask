    <script is:inline>
      const box = document.getElementById('copy-install');
      if (box) {
        const copy = async () => {
          try {
            await navigator.clipboard.writeText('npm install -g mdtask');
            box.classList.add('ring-2', 'ring-tertiary');
            box.setAttribute('title', 'Copied');
            setTimeout(() => {
              box.classList.remove('ring-2', 'ring-tertiary');
              box.setAttribute('title', 'Copy');
            }, 900);
          } catch (e) {}
        };
        box.addEventListener('click', copy);
        box.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); copy(); }
        });
      }
    </script>
