---
interface Props {
  as?: keyof HTMLElementTagNameMap;
  class?: string;
}

const { as: Tag = 'div', class: className = '' } = Astro.props;
const classes = ['font-mono font-semibold text-ink', className].filter(Boolean).join(' ');
---

<Tag class={classes}>
  <span class="text-acc">[x]</span><span>mdtask</span>
</Tag>
