---
interface Props {
  as?: keyof HTMLElementTagNameMap;
  class?: string;
}

const { as: Tag = 'div', class: className = '' } = Astro.props;
const classes = ['font-logo font-semibold text-ink', className].filter(Boolean).join(' ');
---

<Tag class={classes}>
  <span>[</span><span class="bg-[#2f8f5b]/10 px-[0.06em]">x</span><span>]</span><span>mdtask</span>
</Tag>
